# PostgreSQL connection string
DATABASE_URL=postgresql://user:password@localhost:5432/hermes_hub

# 32-byte hex key for AES-256 credential encryption
# Generate one with: openssl rand -hex 32
ENCRYPTION_KEY=

# Secret for Better Auth session signing
BETTER_AUTH_SECRET=

# Public URL of the app (used for magic link emails in production)
# In development, this is usually http://localhost:3000
BETTER_AUTH_URL=http://localhost:3000

# The Hermes agent Docker image is published on Docker Hub as
# nousresearch/hermes-agent (public). No credentials needed by default.
#
# If you mirror the image to GitHub Container Registry and want to pull
# from there, set GHCR_USERNAME and GHCR_TOKEN. Generate a classic PAT at
# https://github.com/settings/tokens with at least `read:packages` scope.
GHCR_USERNAME=
GHCR_TOKEN=
