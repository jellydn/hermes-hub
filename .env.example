# PostgreSQL connection string
DATABASE_URL=postgresql://user:password@localhost:5432/hermes_hub

# 32-byte hex key for AES-256 credential encryption
# Generate one with: openssl rand -hex 32
ENCRYPTION_KEY=

# Secret for Better Auth session signing
BETTER_AUTH_SECRET=

# Public URL of the app (used for magic link emails in production)
# In development, this is usually http://localhost:3000
BETTER_AUTH_URL=http://localhost:3000

# DeepSeek API key (required when using the DeepSeek provider)
# Apply at https://platform.deepseek.com/api_keys
# DEEPSEEK_API_KEY=
