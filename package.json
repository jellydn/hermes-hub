{
	"name": "hermes-hub",
	"private": true,
	"type": "module",
	"imports": {
		"#/*": "./src/*",
		"#server/*": "./server/*",
		"#shared/*": "./shared/*"
	},
	"scripts": {
		"dev": "vite dev --port 3000",
		"build": "vite build",
		"db:generate": "drizzle-kit generate",
		"db:migrate": "node scripts/db-migrate.mjs",
		"preview": "vite preview",
		"re-encrypt": "bun run scripts/re-encrypt.ts",
		"test:dokku-setup": "bash scripts/setup-dokku-deploy-secrets.test.sh",
		"test": "bun run test:dokku-setup && vitest run --passWithNoTests --reporter=dot",
		"test:coverage": "bun run test:dokku-setup && vitest run --coverage --passWithNoTests --reporter=dot",
		"typecheck": "tsc --noEmit",
		"doctor": "react-doctor",
		"brand:assets": "bun run scripts/generate-brand-assets.ts"
	},
	"dependencies": {
		"@better-auth/drizzle-adapter": "^1.6.11",
		"@hookform/resolvers": "^5.4.0",
		"@radix-ui/react-slot": "^1.2.4",
		"@tanstack/react-router": "^1.170.11",
		"@tanstack/react-start": "^1.168.20",
		"@tanstack/router-core": "1.171.9",
		"better-auth": "^1.6.11",
		"class-variance-authority": "^0.7.1",
		"clsx": "^2.1.1",
		"drizzle-kit": "^0.31.10",
		"drizzle-orm": "^0.45.2",
		"hono": "^4.12.23",
		"lucide-react": "^1.16.0",
		"node-ssh": "^13.2.1",
		"pino": "^10.3.1",
		"pino-pretty": "^13.1.3",
		"postgres": "^3.4.9",
		"rate-limiter-flexible": "^11.1.0",
		"react": "^19.2.0",
		"react-dom": "^19.2.0",
		"react-hook-form": "^7.76.1",
		"tailwind-merge": "^3.6.0",
		"tailwindcss": "^4.1.18",
		"zod": "^4.4.3"
	},
	"devDependencies": {
		"@changesets/cli": "^3.0.0",
		"@tailwindcss/typography": "^0.5.16",
		"@tailwindcss/vite": "^4.1.18",
		"@tanstack/devtools-vite": "^0.8.0",
		"@tanstack/react-devtools": "^0.10.5",
		"@tanstack/react-router-devtools": "^1.167.0",
		"@testing-library/dom": "^10.4.1",
		"@testing-library/react": "^16.3.0",
		"@types/node": "^26.0.0",
		"@types/react": "^19.2.0",
		"@types/react-dom": "^19.2.0",
		"@vitejs/plugin-react": "^6.0.1",
		"@vitest/coverage-v8": "^5.0.0",
		"happy-dom": "^20.10.1",
		"jsdom": "^30.0.0",
		"react-doctor": "^0.9.0",
		"typescript": "^7.0.0",
		"vite": "^8.0.0",
		"vitest": "^5.0.0",
		"yaml": "^2.9.0"
	}
}
